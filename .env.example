# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Часовой пояс для расчёта времени напоминаний
TZ=Europe/Moscow

# Час отправки напоминаний (0–23), по указанному TZ
REMIND_HOUR=11

# Каталог для файлов состояния (подписчики, журнал отправок).
# В Docker уже задан как /data через docker-compose.
STATE_DIR=data

# ТОЛЬКО ДЛЯ ТЕСТА. Если задать дату (ГГГГ-ММ-ДД), бот при старте сразу проверит
# этот день и, если для него есть напоминание, разошлёт его подписчикам немедленно
# (в обход журнала отправок). Примеры: 2026-12-16 (спец-текст), 2026-02-13 (перенос).
# В обычной работе оставьте пустым/закомментированным.
#TEST_DATE=2026-12-16
