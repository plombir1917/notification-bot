# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Часовой пояс для расчёта времени напоминаний
TZ=Europe/Moscow

# Час отправки напоминаний (0–23), по указанному TZ
REMIND_HOUR=11

# Каталог для файлов состояния (подписчики, журнал отправок).
# В Docker уже задан как /data через docker-compose.
STATE_DIR=data
